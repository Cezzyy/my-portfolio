---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import profilePic from '../../assets/profilepic.webp';
import BrandGlyph from '../ui/BrandGlyph.astro';

interface Props {
  info: CollectionEntry<'info'>['data'];
  projectCount: number;
}
const { info, projectCount } = Astro.props;
const winner = info.highlights[0];
const winYear = winner?.period.match(/\d{4}/)?.[0];
const winEvent = winner?.org.replace(/\s*\d{4}$/, '');
const gradYear = info.education?.year.match(/\d{4}/)?.[0];

// Text that runs around the "open to work" badge. textLength stretches it to close the circle.
const ringText = 'Open to work ✦ Internships ✦ Freelance ✦ ';
const ringRadius = 46;
const ringLength = 2 * Math.PI * ringRadius;
---

<section
  id="top"
  data-hero
  class="relative overflow-x-clip lg:flex lg:min-h-[calc(100svh-var(--spacing-header))] lg:items-center"
  aria-labelledby="hero-title"
>
  <div class="dot-field pointer-events-none absolute inset-0" aria-hidden="true"></div>

  <div
    class="relative mx-auto grid w-full max-w-7xl gap-16 px-4 pt-10 pb-36 sm:px-6 sm:pt-14 sm:pb-24 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)] lg:items-center lg:gap-12 lg:px-8 lg:py-16 xl:gap-20"
  >
    <!-- Copy -->
    <div data-hero-copy>
      <p data-intro data-hero-kicker class="font-display text-xl font-semibold text-quiet sm:text-2xl">
        Hey, I'm {info.nickname}
      </p>

      <h1
        id="hero-title"
        data-intro
        data-hero-title
        class="mt-4 text-[clamp(3rem,1.2rem+6.4vw,6.25rem)] leading-[0.94] font-extrabold tracking-[-0.04em] text-balance"
      >
        I build apps people actually{' '}
        <span class="whitespace-nowrap"
          ><span class="relative isolate inline-block text-evergreen"
            >use<svg
              viewBox="0 0 200 16"
              preserveAspectRatio="none"
              aria-hidden="true"
              class="absolute -bottom-[0.04em] left-[-4%] -z-10 h-[0.28em] w-[108%]"
              ><path
                data-swash
                d="M4 11 C 50 4, 140 2, 196 8"
                pathLength="1"
                stroke-dasharray="1"
                class="fill-none stroke-marigold"
                stroke-width="8"
                stroke-linecap="round"></path></svg
            ></span
          >.</span
        >
      </h1>

      <p data-intro data-hero-fade class="mt-7 max-w-[34rem] text-lg leading-relaxed text-quiet sm:text-xl">
        {info.status} in {info.location}, working toward a career in{' '}
        <strong class="font-semibold text-ink">mobile development</strong>. I build cross-platform apps with Flutter, and
        the web side with Vue, React, Hono and Supabase.
      </p>

      <div data-intro data-hero-fade class="mt-9 flex flex-wrap items-center gap-3">
        <a
          href="#projects"
          data-magnetic
          class="group inline-flex min-h-14 items-center gap-2.5 rounded-full bg-evergreen pr-2 pl-7 text-lg font-semibold text-on-evergreen shadow-[0_14px_30px_-14px_rgb(30_91_68/0.8)] transition-colors hover:bg-evergreen-hover"
        >
          See my work
          <span class="grid size-10 place-items-center rounded-full bg-marigold text-[#12241c] transition-transform duration-300 group-hover:rotate-45">
            <svg class="size-5 fill-none stroke-current stroke-[2.25]" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M7 17 17 7M8 7h9v9" />
            </svg>
          </span>
        </a>
        <a
          href="#contact"
          data-magnetic
          class="inline-flex min-h-14 items-center rounded-full border border-line-strong/60 px-7 text-lg font-semibold text-ink transition-colors hover:border-evergreen hover:text-evergreen"
        >
          Get in touch
        </a>
      </div>

      <dl data-intro data-hero-fade class="mt-12 grid max-w-xl grid-cols-3 gap-4 border-t border-line pt-6 sm:gap-8">
        <div class="flex flex-col-reverse justify-end gap-1">
          <dt class="text-sm leading-snug text-quiet">Projects built</dt>
          <dd class="font-display text-3xl font-bold tabular-nums sm:text-4xl" data-count>{projectCount}</dd>
        </div>
        {winner && winYear && (
          <div class="flex flex-col-reverse justify-end gap-1">
            <dt class="text-sm leading-snug text-quiet">{winEvent} winner</dt>
            <dd class="font-display text-3xl font-bold tabular-nums sm:text-4xl">{winYear}</dd>
          </div>
        )}
        {gradYear && (
          <div class="flex flex-col-reverse justify-end gap-1">
            <dt class="text-sm leading-snug text-quiet">BSCS, expected</dt>
            <dd class="font-display text-3xl font-bold tabular-nums sm:text-4xl">{gradYear}</dd>
          </div>
        )}
      </dl>
    </div>

    <!-- Portrait stage -->
    <div data-hero-stage class="relative mx-auto w-full max-w-[19rem] sm:max-w-[24rem] lg:mr-0 lg:max-w-[27rem]">
      <div class="relative aspect-[4/5]">
        <!-- Marigold slab peeking out from behind -->
        <div data-depth="0.35" class="absolute inset-0">
          <div
            data-intro
            data-hero-slab
            class="size-full translate-x-3 translate-y-3 rotate-[5deg] rounded-[2rem] bg-marigold sm:translate-x-5 sm:translate-y-4"
          >
          </div>
        </div>

        <!-- Portrait -->
        <div data-depth="0.12" class="absolute inset-0">
          <figure
            data-intro
            data-hero-portrait
            class="relative size-full overflow-hidden rounded-[2rem] bg-brand shadow-[0_40px_80px_-40px_rgb(18_36_28/0.6)]"
          >
            <Image
              src={profilePic}
              alt={`Portrait of ${info.name}`}
              widths={[400, 640, 953]}
              sizes="(min-width: 64rem) 27rem, (min-width: 40rem) 24rem, 19rem"
              class="size-full object-cover object-[52%_30%]"
              loading="eager"
              fetchpriority="high"
            />
            <!-- Evergreen wash ties the busy photo background into the palette. -->
            <div class="absolute inset-0 bg-linear-to-b from-[#0c2219]/55 via-transparent to-[#0c2219]/60 mix-blend-multiply" aria-hidden="true"></div>
            <figcaption class="absolute top-0 left-0 p-4 text-white sm:p-5">
              <span class="inline-flex items-center gap-1.5 rounded-full bg-white/15 px-3 py-1.5 text-sm font-semibold backdrop-blur-md">
                <svg class="size-4 fill-none stroke-current stroke-2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 21s-7-5.5-7-11a7 7 0 0 1 14 0c0 5.5-7 11-7 11Z" />
                  <circle cx="12" cy="10" r="2.5" />
                </svg>
                {info.location}
              </span>
            </figcaption>
          </figure>
        </div>

        <!-- "Open to work" badge, top right -->
        <div data-depth="0.5" class="absolute -top-9 -right-3 z-10 sm:-top-11 sm:-right-9">
          <a
            href="#contact"
            data-intro
            data-hero-pop
            class="group relative grid size-26 place-items-center rounded-full bg-surface shadow-[0_18px_40px_-18px_rgb(18_36_28/0.55)] ring-1 ring-line sm:size-30"
          >
            <span class="sr-only">{info.availability}. Get in touch.</span>
            <svg data-spin viewBox="0 0 120 120" class="absolute inset-0 size-full text-ink" aria-hidden="true">
              <defs>
                <path id="badge-ring" d={`M60,60 m-${ringRadius},0 a${ringRadius},${ringRadius} 0 1,1 ${ringRadius * 2},0 a${ringRadius},${ringRadius} 0 1,1 -${ringRadius * 2},0`} />
              </defs>
              <text class="fill-current font-display text-[9.5px] font-bold tracking-[0.08em] uppercase">
                <textPath href="#badge-ring" textLength={ringLength - 2} lengthAdjust="spacing">{ringText}</textPath>
              </text>
            </svg>
            <span class="grid size-12 place-items-center rounded-full bg-evergreen text-on-evergreen transition-transform duration-300 group-hover:scale-110 sm:size-14" aria-hidden="true">
              <svg class="size-6 fill-none stroke-current stroke-2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                <path d="M7 7l10 10M17 8v9H8" />
              </svg>
            </span>
          </a>
        </div>

        <!-- Winner sticker, left; sits below the face at every size -->
        {winner && (
          <div data-depth="0.6" class="absolute top-[63%] -left-3 z-10 sm:-left-12">
            <div
              data-intro
              data-hero-pop
              class="flex -rotate-[4deg] items-center gap-3 rounded-2xl bg-surface p-2.5 pr-4 shadow-[0_18px_40px_-18px_rgb(18_36_28/0.55)] ring-1 ring-line"
            >
              <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-marigold text-[#12241c]" aria-hidden="true">
                <svg class="size-6 fill-none stroke-current stroke-2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M8 21h8M12 17v4M7 4h10v5a5 5 0 0 1-10 0V4Z" />
                  <path d="M17 6h2.5a1.5 1.5 0 0 1 1.5 1.5V8a4 4 0 0 1-4 4M7 6H4.5A1.5 1.5 0 0 0 3 7.5V8a4 4 0 0 0 4 4" />
                </svg>
              </span>
              <span class="leading-tight">
                <span class="block text-sm font-bold">{winner.title}</span>
                <span class="block text-xs font-semibold text-quiet">{winner.org}</span>
              </span>
            </div>
          </div>
        )}

        <!-- Focus and learning widget, bottom right -->
        <div data-depth="0.45" class="absolute -right-2 -bottom-24 z-10 sm:-right-8 sm:-bottom-12">
          <div
            data-intro
            data-hero-pop
            class="w-60 rotate-[2.5deg] rounded-2xl bg-night p-4 text-white shadow-[0_24px_50px_-20px_rgb(0_0_0/0.6)] ring-1 ring-white/10"
          >
            <p class="text-xs font-semibold tracking-wide text-white/60 uppercase">Daily drivers</p>
            <ul class="mt-2.5 flex gap-1.5" aria-label="Current focus">
              {info.currentFocus.map((tool) => (
                <li class="grid size-9 place-items-center rounded-lg bg-white/10" title={tool}>
                  <BrandGlyph name={tool} class="size-4.5 text-white/85" />
                  <span class="sr-only">{tool}</span>
                </li>
              ))}
            </ul>
            <p class="mt-3.5 flex items-center gap-2 border-t border-white/10 pt-3 text-sm">
              <span class="relative flex size-2 shrink-0" aria-hidden="true">
                <span class="absolute inline-flex size-full rounded-full bg-marigold opacity-70 motion-safe:animate-ping"></span>
                <span class="relative inline-flex size-2 rounded-full bg-marigold"></span>
              </span>
              <span class="text-white/70">Learning</span>
              <span class="font-semibold">{info.learning.join(' + ')}</span>
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <a
    href="#about"
    class="absolute bottom-6 left-1/2 hidden -translate-x-1/2 flex-col items-center gap-2 text-xs font-semibold tracking-[0.2em] text-quiet uppercase lg:flex"
  >
    Scroll
    <span class="relative block h-10 w-px overflow-hidden bg-line" aria-hidden="true">
      <span class="scroll-cue absolute inset-x-0 top-0 h-1/2 bg-evergreen"></span>
    </span>
  </a>
</section>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .scroll-cue {
      animation: cue 1.8s cubic-bezier(0.65, 0, 0.35, 1) infinite;
    }
    @keyframes cue {
      from {
        translate: 0 -100%;
      }
      to {
        translate: 0 200%;
      }
    }
  }
</style>
