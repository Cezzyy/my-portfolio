---
import { getEntry } from 'astro:content';
import HeroSectionAnimator from '../vue/animations/HeroSectionAnimator.vue';
import { siGithub, siFacebook, siInstagram } from 'simple-icons';

const personalInfo = await getEntry('info', 'personal');
if (!personalInfo) {
    throw new Error('Personal information not found');
}
const { name, status, location, goal, currentFocus, motto } = personalInfo.data;
---

<HeroSectionAnimator client:load>
<section
    class="hero-section relative min-h-screen flex items-center justify-center overflow-hidden bg-elegant-black"
>

    <!-- Elegant Background Pattern -->
    <div class="absolute inset-0">
        <!-- Diagonal Lines Pattern -->
        <div class="absolute inset-0 opacity-5">
            <div class="absolute inset-0" style="background-image: repeating-linear-gradient(45deg, transparent, transparent 35px, rgba(255,255,255,.1) 35px, rgba(255,255,255,.1) 70px);"></div>
        </div>
        
        <!-- Radial Gradient Overlay -->
        <div class="absolute inset-0 bg-gradient-radial from-elegant-dark-gray/50 via-elegant-black to-elegant-black"></div>
        
        <!-- Animated Dots -->
        <div class="absolute inset-0 opacity-20">
            <div class="absolute top-1/4 left-1/4 w-2 h-2 bg-elegant-white rounded-full animate-pulse"></div>
            <div class="absolute top-1/3 right-1/3 w-1 h-1 bg-elegant-white rounded-full animate-pulse" style="animation-delay: 1s;"></div>
            <div class="absolute bottom-1/4 left-1/3 w-1.5 h-1.5 bg-elegant-white rounded-full animate-pulse" style="animation-delay: 2s;"></div>
            <div class="absolute bottom-1/3 right-1/4 w-1 h-1 bg-elegant-white rounded-full animate-pulse" style="animation-delay: 1.5s;"></div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="relative z-10 max-w-7xl mx-auto px-3 sm:px-4 md:px-6 lg:px-8 py-6 sm:py-8 md:py-12 lg:py-16 mt-14 sm:mt-16">
        <div class="grid md:grid-cols-2 gap-6 sm:gap-8 lg:gap-12 items-center">
            <!-- Left Column - Text Content -->
            <div class="text-left space-y-2.5 sm:space-y-3 md:space-y-4 lg:space-y-5 hero-content">
                <h1 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl xl:text-6xl font-bold leading-tight">
                    <span class="block text-elegant-off-white mb-0.5 sm:mb-1">Hello, I'm</span>
                    <span class="block text-elegant-white">
                        {name.split(' ')[0]} {name.split(' ')[1]}
                    </span>
                    <span class="block text-elegant-white">
                        {name.split(' ')[2]}
                    </span>
                </h1>

                <div class="hero-subtitle flex items-center gap-1.5 sm:gap-2 text-sm sm:text-base md:text-lg lg:text-xl text-elegant-off-white">
                    <span>I'm a</span>
                    <span class="typing-text font-semibold text-elegant-white"></span>
                </div>

                <div class="hero-location flex items-center gap-1.5 sm:gap-2 text-xs sm:text-sm md:text-base text-elegant-off-white">
                    <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 md:w-5 md:h-5 text-elegant-white flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    </svg>
                    <span>{location}</span>
                </div>

                <p class="hero-description text-xs sm:text-sm md:text-base lg:text-lg text-elegant-off-white max-w-xl leading-relaxed">
                    {goal}. Currently focusing on <span class="text-elegant-white font-semibold">{currentFocus.join(', ')}</span>.
                </p>

                <div class="hero-buttons flex flex-wrap gap-2 sm:gap-3 pt-2 sm:pt-3 md:pt-4">
                    <a
                        href="#projects"
                        class="group px-4 sm:px-5 md:px-6 lg:px-7 py-2 sm:py-2.5 md:py-3 bg-elegant-white text-elegant-black font-semibold text-xs sm:text-sm rounded-lg transition-all duration-300 transform hover:scale-105 hover:shadow-2xl hover:shadow-elegant-white/20 relative overflow-hidden"
                    >
                        <span class="relative z-10">View My Work</span>
                    </a>
                    <a
                        href="#contact"
                        class="px-4 sm:px-5 md:px-6 lg:px-7 py-2 sm:py-2.5 md:py-3 bg-transparent border-2 border-elegant-white text-elegant-white font-semibold text-xs sm:text-sm rounded-lg hover:bg-elegant-white hover:text-elegant-black transition-all duration-300 transform hover:scale-105 relative overflow-hidden group"
                    >
                        <span class="relative z-10">Get In Touch</span>
                    </a>
                </div>

                <!-- Social Links -->
                <div class="hero-social flex gap-2 sm:gap-3 pt-2 sm:pt-3 md:pt-4">
                    <a href="https://github.com/Cezzyy" target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="GitHub Profile">
                        <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="currentColor" role="img" viewBox="0 0 24 24">
                            <path d={siGithub.path} />
                        </svg>
                    </a>
                    <a href="https://www.linkedin.com/in/john-cez-casupanan-07196027b/" target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="LinkedIn Profile">
                        <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                        </svg>
                    </a>
                    <a href="https://www.facebook.com/john.cez.casupanan04" target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="Facebook Profile">
                        <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="currentColor" role="img" viewBox="0 0 24 24">
                            <path d={siFacebook.path} />
                        </svg>
                    </a>
                    <a href="https://www.instagram.com/cezzyyyyyy_" target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="Instagram Profile">
                        <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="currentColor" role="img" viewBox="0 0 24 24">
                            <path d={siInstagram.path} />
                        </svg>
                    </a>
                </div>
            </div>

            <!-- Right Column - Code Editor -->
            <div class="hidden lg:flex items-center justify-center hero-visual">
                <div class="code-editor w-full max-w-lg">
                    <!-- Editor Header -->
                    <div class="editor-header flex items-center justify-between px-4 py-3 bg-elegant-dark-gray rounded-t-xl border-b border-elegant-light-gray/20">
                        <div class="flex items-center gap-2">
                            <div class="w-3 h-3 rounded-full bg-elegant-soft-gray animate-pulse-slow"></div>
                            <div class="w-3 h-3 rounded-full bg-elegant-pale-gray animate-pulse-slow" style="animation-delay: 0.2s;"></div>
                            <div class="w-3 h-3 rounded-full bg-elegant-white animate-pulse-slow" style="animation-delay: 0.4s;"></div>
                        </div>
                        <div class="flex items-center gap-2 text-elegant-off-white text-sm font-mono">
                            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M12.316 3.051a1 1 0 01.633 1.265l-4 12a1 1 0 11-1.898-.632l4-12a1 1 0 011.265-.633zM5.707 6.293a1 1 0 010 1.414L3.414 10l2.293 2.293a1 1 0 11-1.414 1.414l-3-3a1 1 0 010-1.414l3-3a1 1 0 011.414 0zm8.586 0a1 1 0 011.414 0l3 3a1 1 0 010 1.414l-3 3a1 1 0 11-1.414-1.414L16.586 10l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd"></path>
                            </svg>
                            <span>developer.dart</span>
                        </div>
                    </div>

                    <!-- Editor Content -->
                    <div class="editor-content bg-elegant-black p-6 rounded-b-xl font-mono text-sm overflow-hidden relative border border-elegant-light-gray/20">
                        <!-- Line Numbers -->
                        <div class="flex gap-4">
                            <div class="line-numbers text-elegant-soft-gray select-none">
                                <div class="typing-line">1</div>
                                <div class="typing-line">2</div>
                                <div class="typing-line">3</div>
                                <div class="typing-line">4</div>
                                <div class="typing-line">5</div>
                                <div class="typing-line">6</div>
                                <div class="typing-line">7</div>
                                <div class="typing-line">8</div>
                                <div class="typing-line">9</div>
                                <div class="typing-line">10</div>
                                <div class="typing-line">11</div>
                                <div class="typing-line">12</div>
                                <div class="typing-line">13</div>
                            </div>

                            <!-- Code Content -->
                            <div class="code-content flex-1">
                                <div class="typing-line"><span class="text-white font-bold">class</span> <span class="text-white font-semibold">Developer</span> <span class="text-white">&#123;</span></div>
                                <div class="typing-line pl-4"><span class="text-white font-bold">final</span> <span class="text-white font-semibold">String</span> <span class="text-white">name</span> <span class="text-white font-medium">=</span> <span class="text-white italic">'{name}'</span><span class="text-white">;</span></div>
                                <div class="typing-line pl-4"><span class="text-white font-bold">final</span> <span class="text-white font-semibold">String</span> <span class="text-white">status</span> <span class="text-white font-medium">=</span> <span class="text-white italic">'{status}'</span><span class="text-white">;</span></div>
                                <div class="typing-line pl-4"><span class="text-white font-bold">final</span> <span class="text-white font-semibold">String</span> <span class="text-white">location</span> <span class="text-white font-medium">=</span> <span class="text-white italic">'{location}'</span><span class="text-white">;</span></div>
                                <div class="typing-line pl-4"><span class="text-white font-bold">final</span> <span class="text-white font-semibold">String</span> <span class="text-white">goal</span> <span class="text-white font-medium">=</span> <span class="text-white italic">'{goal}'</span><span class="text-white">;</span></div>
                                <div class="typing-line pl-4"><span class="text-white font-bold">final</span> <span class="text-white font-semibold">List</span><span class="text-white">&lt;</span><span class="text-white font-semibold">String</span><span class="text-white">&gt;</span> <span class="text-white">focus</span> <span class="text-white font-medium">=</span> <span class="text-white">[</span></div>
                                {currentFocus.map((tech, index) => (
                                    <div class="typing-line pl-8">
                                        <span class="text-white italic">'{tech}'</span><span class="text-white">{index < currentFocus.length - 1 ? ',' : ','}</span>
                                    </div>
                                ))}
                                <div class="typing-line pl-4"><span class="text-white">]</span><span class="text-white">;</span></div>
                                <div class="typing-line pl-4"><span class="text-white font-bold">final</span> <span class="text-white font-semibold">String</span> <span class="text-white">motto</span> <span class="text-white font-medium">=</span> <span class="text-white italic">'{motto.slice(0, 35)}...'</span><span class="text-white">;</span></div>
                                <div class="typing-line"><span class="text-white">&#125;</span></div>
                            </div>
                        </div>

                        <!-- Cursor -->
                        <div class="cursor"></div>
                    </div>

                    <!-- Editor Footer -->
                    <div class="editor-footer flex items-center justify-between px-4 py-2 bg-elegant-dark-gray rounded-b-lg text-xs font-mono text-elegant-off-white border-t border-elegant-light-gray/20">
                        <div class="flex items-center gap-4">
                            <span>Dart</span>
                            <span>UTF-8</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <div class="w-2 h-2 rounded-full bg-elegant-white animate-pulse"></div>
                            <span>Ready</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Scroll Indicator -->
    <div class="scroll-indicator absolute bottom-4 sm:bottom-6 md:bottom-8 left-1/2 transform -translate-x-1/2 animate-bounce">
        <div class="flex flex-col items-center gap-1 sm:gap-2">
            <span class="text-elegant-white text-xs sm:text-sm">Scroll Down</span>
            <svg
                class="w-5 h-5 sm:w-6 sm:h-6 text-elegant-white"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
            </svg>
        </div>
    </div>
</section>
</HeroSectionAnimator>

<style>
    /* Code Editor Styles */
    .code-editor {
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.8);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 0.75rem;
        overflow: hidden;
    }

    .typing-line {
        opacity: 0;
        transform: translateX(-10px);
        line-height: 1.8;
    }

    .cursor {
        position: absolute;
        bottom: 1.5rem;
        right: 1.5rem;
        width: 8px;
        height: 16px;
        background: #ffffff;
        animation: blink-cursor 1s infinite;
    }

    @keyframes blink-cursor {
        0%, 50% { opacity: 1; }
        51%, 100% { opacity: 0; }
    }

    @keyframes pulse-slow {
        0%, 100% {
            opacity: 0.3;
            transform: scale(1);
        }
        50% {
            opacity: 1;
            transform: scale(1.2);
        }
    }

    .animate-pulse-slow {
        animation: pulse-slow 3s ease-in-out infinite;
    }

    /* Floating Shapes */
    .floating-shape {
        position: absolute;
        background: linear-gradient(135deg, rgba(255, 255, 255, 0.03), rgba(255, 255, 255, 0.01));
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 20% 80% 60% 40% / 70% 30% 70% 30%;
        animation: float 20s infinite ease-in-out;
        opacity: 0;
        transform: scale(0.8);
    }

    .shape-1 {
        width: 300px;
        height: 300px;
        top: 10%;
        left: 5%;
        animation-delay: 0s;
    }

    .shape-2 {
        width: 200px;
        height: 200px;
        top: 60%;
        right: 10%;
        animation-delay: 2s;
    }

    .shape-3 {
        width: 150px;
        height: 150px;
        bottom: 20%;
        left: 15%;
        animation-delay: 4s;
    }

    .shape-4 {
        width: 250px;
        height: 250px;
        top: 30%;
        right: 20%;
        animation-delay: 1s;
    }

    .shape-5 {
        width: 180px;
        height: 180px;
        bottom: 10%;
        right: 5%;
        animation-delay: 3s;
    }

    @keyframes float {
        0%, 100% {
            transform: translateY(0) rotate(0deg);
        }
        50% {
            transform: translateY(-30px) rotate(180deg);
        }
    }

    /* Typing Cursor for roles */
    .typing-text::after {
        content: '|';
        animation: blink 1s infinite;
    }

    @keyframes blink {
        0%, 50% { opacity: 1; }
        51%, 100% { opacity: 0; }
    }

    /* Social Icons */
    .social-icon {
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        background: #ffffff;
        border: 2px solid #ffffff;
        color: #0a0a0a;
        transition: all 0.3s ease;
    }

    @media (min-width: 640px) {
        .social-icon {
            width: 40px;
            height: 40px;
            border-radius: 10px;
        }
    }

    .social-icon:hover {
        background: rgba(255, 255, 255, 0.9);
        color: #0a0a0a;
        transform: translateY(-3px);
        box-shadow: 0 6px 12px rgba(255, 255, 255, 0.4);
    }

    /* Initial states for GSAP animations */
    .hero-content h1,
    .hero-subtitle,
    .hero-location,
    .hero-description,
    .hero-buttons,
    .hero-social {
        opacity: 0;
        transform: translateY(30px);
    }

    .hero-visual {
        opacity: 0;
        transform: scale(0.9);
    }

    .scroll-indicator {
        opacity: 0;
        transform: translateY(-20px) translateX(-50%);
    }
</style>
