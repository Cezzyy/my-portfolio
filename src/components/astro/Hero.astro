---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import profilePic from '../../assets/profilepic.webp';

interface Props {
  info: CollectionEntry<'info'>['data'];
  featuredCount: number;
}
const { info, featuredCount } = Astro.props;
const winner = info.highlights[0];
const gradYear = info.education?.year.match(/\d{4}/)?.[0];

// Two list items per line keeps the snippet inside the card on every width.
const pairs = (items: string[]) =>
  items.reduce<string[][]>((rows, item, i) => (i % 2 ? rows[rows.length - 1].push(item) : rows.push([item]), rows), []);
---

<section id="top" class="overflow-x-clip" aria-labelledby="hero-title">
  <div
    class="hero-grid mx-auto grid w-full max-w-7xl grid-cols-[minmax(0,1fr)] px-4 pt-10 pb-16 sm:px-6 sm:pt-14 md:grid-cols-[minmax(0,1fr)_minmax(0,22rem)] md:gap-x-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,27rem)] lg:grid-rows-[auto_1fr] lg:gap-x-16 lg:px-8 lg:pt-20 lg:pb-24"
  >
    <div class="[grid-area:intro]">
      <p class="inline-flex items-center gap-2 rounded-full border border-line bg-surface px-3.5 py-1.5 text-sm font-semibold text-quiet motion-safe:animate-rise">
        <span class="relative flex size-2" aria-hidden="true">
          <span class="absolute inline-flex size-full rounded-full bg-evergreen opacity-60 motion-safe:animate-ping"></span>
          <span class="relative inline-flex size-2 rounded-full bg-evergreen"></span>
        </span>
        {info.availability}
      </p>

      <h1
        id="hero-title"
        class="mt-6 text-[clamp(2.75rem,1.6rem+4.4vw,5rem)] leading-[0.98] font-extrabold tracking-[-0.025em] text-balance motion-safe:animate-rise motion-safe:[animation-delay:80ms]"
      >
        Hey, I'm {info.nickname}. I build apps people actually{' '}
        <span class="whitespace-nowrap"
          ><span class="relative isolate inline-block text-evergreen"
            >use<svg
              viewBox="0 0 200 16"
              preserveAspectRatio="none"
              aria-hidden="true"
              class="absolute -bottom-[0.06em] left-[-3%] -z-10 h-[0.3em] w-[106%]"
              ><path
                d="M4 11 C 50 4, 140 2, 196 8"
                pathLength="1"
                class="swash fill-none stroke-marigold"
                stroke-width="7"
                stroke-linecap="round"></path></svg
            ></span
          >.</span
        >
      </h1>

      <p class="mt-6 max-w-[36rem] text-lg leading-relaxed text-quiet sm:text-xl motion-safe:animate-rise motion-safe:[animation-delay:160ms]">
        {info.status} in {info.location}, working toward a career in mobile development. I build
        cross-platform apps with Flutter, and the web side with Vue, React, Hono and Supabase.
      </p>
    </div>

    <div class="mt-8 [grid-area:actions] md:self-center lg:self-start">
      <div class="flex flex-wrap items-center gap-x-2 gap-y-3 motion-safe:animate-rise motion-safe:[animation-delay:240ms]">
        <a
          href="#projects"
          class="group inline-flex min-h-13 items-center gap-2 rounded-control bg-evergreen px-7 text-lg font-semibold text-on-evergreen shadow-[0_10px_24px_-10px_rgb(30_91_68/0.7)] transition-colors hover:bg-evergreen-hover"
        >
          See my work
          <svg class="size-5 fill-none stroke-current stroke-2 transition-transform group-hover:translate-x-0.5" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </a>
        <a href="#contact" class="inline-flex min-h-13 items-center px-4 font-semibold text-evergreen underline-offset-4 hover:underline">
          Get in touch
        </a>
      </div>

      <dl class="mt-10 flex max-w-lg divide-x divide-line-strong/25 motion-safe:animate-rise motion-safe:[animation-delay:320ms]">
        <div class="flex flex-1 flex-col-reverse justify-end px-4 first:pl-0 last:pr-0 sm:px-6">
          <dt class="text-sm text-quiet">Featured projects</dt>
          <dd class="font-display text-3xl font-bold tabular-nums sm:text-4xl">{featuredCount}</dd>
        </div>
        {winner && (
          <div class="flex flex-1 flex-col-reverse justify-end px-4 first:pl-0 last:pr-0 sm:px-6">
            <dt class="text-sm text-quiet">{winner.org.replace(/\s*\d{4}$/, '')} winner</dt>
            <dd class="font-display text-3xl font-bold tabular-nums sm:text-4xl">{winner.period.match(/\d{4}/)?.[0]}</dd>
          </div>
        )}
        {gradYear && (
          <div class="flex flex-1 flex-col-reverse justify-end px-4 first:pl-0 last:pr-0 sm:px-6">
            <dt class="text-sm text-quiet">BSCS, expected</dt>
            <dd class="font-display text-3xl font-bold tabular-nums sm:text-4xl">{gradYear}</dd>
          </div>
        )}
      </dl>
    </div>

    <aside
      aria-label={`About ${info.nickname} at a glance`}
      class="mt-12 w-full max-w-md self-start [grid-area:card] motion-safe:animate-rise motion-safe:[animation-delay:280ms] md:mt-8 lg:mt-0"
    >
      <div class="relative rounded-[1.25rem] border border-line bg-surface shadow-[0_1px_0_var(--color-line),0_30px_60px_-30px_rgb(18_36_28/0.35)]">
        <header class="flex items-center gap-3.5 border-b border-line px-5 py-4">
          <Image
            src={profilePic}
            alt={`Portrait of ${info.name}`}
            width={112}
            height={112}
            class="size-14 shrink-0 rounded-full object-cover ring-2 ring-evergreen-soft"
            loading="eager"
          />
          <div class="min-w-0">
            <p class="truncate font-display text-lg font-bold">{info.name}</p>
            <p class="truncate text-sm text-quiet">@{info.username} · {info.role}</p>
          </div>
        </header>

        <div class="p-5">
          <figure>
            <figcaption class="flex items-center justify-between text-xs font-semibold text-quiet">
              <span>cez.dart</span>
              <span class="inline-flex items-center gap-1.5">
                <span class="size-1.5 rounded-full bg-evergreen" aria-hidden="true"></span>Dart
              </span>
            </figcaption>
            <pre
              class="mt-2 overflow-x-auto rounded-card bg-mist-soft px-4 py-3.5 font-mono text-xs leading-relaxed text-ink sm:text-[0.8125rem]"><code><span class="font-semibold text-evergreen">class</span> Cez {'{'}
  <span class="text-evergreen">final</span> status = <span class="text-marigold-text">"{info.status}"</span>;
  <span class="text-evergreen">final</span> location = <span class="text-marigold-text">"{info.location}"</span>;
  <span class="text-evergreen">final</span> goal = <span class="text-marigold-text">"{info.goal}"</span>;

  <span class="text-evergreen">final</span> focus = [
{pairs(info.currentFocus).map((line) => (<Fragment>{'    '}{line.map((item, i) => (<Fragment>{i > 0 && ' '}<span class="text-marigold-text">"{item}"</span>,</Fragment>))}{'\n'}</Fragment>))}  ];
  <span class="text-evergreen">final</span> learning = [{info.learning.map((item, i) => (<Fragment>{i > 0 && ', '}<span class="text-marigold-text">"{item}"</span></Fragment>))}];
{'}'}</code></pre>
          </figure>

          <blockquote class="mt-4 rounded-card bg-marigold-soft p-4">
            <p class="text-sm font-semibold text-marigold-text">Motto</p>
            <p class="mt-1 leading-snug">{info.motto}</p>
          </blockquote>
        </div>
      </div>
    </aside>
  </div>
</section>

<style>
  .hero-grid {
    grid-template-areas: 'intro' 'actions' 'card';
  }
  @media (width >= 48rem) {
    .hero-grid {
      grid-template-areas: 'intro intro' 'actions card';
    }
  }
  @media (width >= 64rem) {
    .hero-grid {
      grid-template-areas: 'intro card' 'actions card';
    }
  }
</style>
