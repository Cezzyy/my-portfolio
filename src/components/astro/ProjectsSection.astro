---
import ProjectsSectionAnimator from '../vue/animations/ProjectsSectionAnimator.vue';
import { getCollection } from 'astro:content';
import type { SimpleIcon } from 'simple-icons';
import { siFlutter, siSupabase, siPython, siSharp, siDotnet, siGithub } from 'simple-icons';

// Get all projects from MDX files and sort by order
const allProjects = await getCollection('projects');
const sortedProjects = allProjects.sort((a, b) => a.data.order - b.data.order);

// Icon mapping
const iconMap: Record<string, SimpleIcon> = {
  flutter: siFlutter,
  supabase: siSupabase,
  python: siPython,
  sharp: siSharp,
  dotnet: siDotnet,
  github: siGithub,
};

// Map tech icon names to simple-icons
const getIconFromName = (iconName: string): SimpleIcon | null => {
  return iconMap[iconName.toLowerCase()] || null;
};

// Transform projects data from MDX
const projects = sortedProjects.map((project) => ({
  title: project.data.title,
  description: project.data.description,
  tags: project.data.tags,
  status: project.data.status,
  icons: project.data.techIcons
    .map(iconName => getIconFromName(iconName))
    .filter((icon): icon is SimpleIcon => icon !== null),
  demoUrl: project.data.demoUrl || null,
  demoLabel: project.data.demoLabel || 'View Demo',
  demoNote: project.data.demoNote || null,
  githubUrl: project.data.githubUrl || null
}));
---

<ProjectsSectionAnimator client:load>
<section id="projects" class="relative min-h-screen py-16 lg:py-20 overflow-hidden bg-elegant-black">
  <!-- Creative Background -->
  <div class="absolute inset-0">
    <!-- Diagonal Stripes -->
    <div class="absolute inset-0 opacity-5">
      <div class="absolute inset-0" style="background: repeating-linear-gradient(-45deg, transparent, transparent 10px, rgba(255,255,255,.05) 10px, rgba(255,255,255,.05) 20px);"></div>
    </div>
    
    <!-- Radial Gradients -->
    <div class="absolute top-0 left-1/4 w-96 h-96 bg-elegant-white/5 rounded-full blur-3xl"></div>
    <div class="absolute bottom-0 right-1/4 w-96 h-96 bg-elegant-white/5 rounded-full blur-3xl"></div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center mb-8 lg:mb-12">
      <h2 class="projects-title text-3xl sm:text-4xl lg:text-5xl font-bold text-elegant-white mb-3">
        My Projects
      </h2>
      <div class="projects-underline w-20 h-1 bg-elegant-white mx-auto mb-3"></div>
      <p class="projects-subtitle text-sm lg:text-base text-elegant-off-white max-w-2xl mx-auto px-2">
        A showcase of my recent work and upcoming ventures
      </p>
    </div>

    <!-- Projects Drawer Layout -->
    <div class="space-y-6 lg:space-y-8">
      {projects.map((project, index) => (
        <div
          class={`project-card project-card-${index}`}
          data-status={project.status}
        >
          <div class={`group relative bg-elegant-dark-gray/60 backdrop-blur-lg rounded-xl lg:rounded-2xl border border-elegant-white/10 shadow-2xl overflow-hidden transition-all duration-500 hover:border-elegant-white/30 hover:shadow-elegant-white/10 ${index % 2 === 0 ? '' : ''}`}>
            <div class={`grid md:grid-cols-2 gap-0 min-h-[280px] lg:min-h-[320px] ${index % 2 === 1 ? 'md:grid-flow-dense' : ''}`}>

              {/* Project Image/Visual - Alternates sides */}
              <div class={`relative overflow-hidden hidden md:block ${index % 2 === 1 ? 'md:col-start-2' : ''} bg-elegant-black/40`}>
                <div class="absolute inset-0 flex items-center justify-center p-4 lg:p-6">
                  <div class="grid grid-cols-2 gap-4 lg:gap-6">
                    {project.icons.map((icon) => (
                      <div class="flex items-center justify-center">
                        <svg role="img" viewBox="0 0 24 24" fill="currentColor" class="w-14 lg:w-16 h-14 lg:h-16 transition-all duration-300 text-elegant-white/80 hover:text-elegant-white hover:scale-110" style={`color: #${icon.hex}`}>
                          <path d={icon.path} />
                        </svg>
                      </div>
                    ))}
                  </div>
                </div>

                {/* Status Badge */}
                {project.status === 'upcoming' && (
                  <div class="absolute top-4 right-4 z-20 px-3 py-1.5 bg-elegant-white text-elegant-black rounded-full text-xs font-bold uppercase tracking-wider shadow-lg">
                    Coming Soon
                  </div>
                )}
              </div>

              {/* Project Content - Alternates sides */}
              <div class={`flex flex-col justify-center p-5 lg:p-7 ${index % 2 === 1 ? 'md:col-start-1 md:row-start-1' : ''}`}>
                <div class="space-y-3 lg:space-y-4">
                  {/* Project Number */}
                  <div class="inline-block">
                    <span class="text-4xl lg:text-5xl font-bold text-elegant-white/10">0{index + 1}</span>
                  </div>

                  <h3 class="text-xl lg:text-2xl font-bold text-elegant-white group-hover:text-elegant-white transition-colors duration-300">
                    {project.title}
                  </h3>

                  <p class="text-elegant-off-white text-sm lg:text-base leading-relaxed">
                    {project.description}
                  </p>

                  {/* Tags */}
                  <div class="flex flex-wrap gap-2">
                    {project.tags.map((tag) => (
                      <span class="px-2.5 py-1 bg-elegant-white/10 border border-elegant-white/20 rounded-lg text-elegant-off-white font-medium text-xs hover:bg-elegant-white/20 transition-colors">
                        {tag}
                      </span>
                    ))}
                  </div>

                  {/* Action Buttons */}
                  {project.status === 'completed' && (
                    <div class="pt-2">
                      <div class="flex flex-wrap gap-2">
                        {project.demoUrl === '#' ? (
                          <button
                            disabled
                            class="flex items-center gap-1.5 px-4 py-2 bg-elegant-white/20 text-elegant-off-white/60 font-bold text-xs rounded-lg cursor-not-allowed opacity-60"
                          >
                            <span>{project.demoLabel}</span>
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
                              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                            </svg>
                          </button>
                        ) : (
                          <a
                            href={project.demoUrl}
                            class="flex items-center gap-1.5 px-4 py-2 bg-elegant-white text-elegant-black font-bold text-xs rounded-lg hover:shadow-lg hover:shadow-elegant-white/30 transition-all duration-300 hover:-translate-y-0.5"
                          >
                            <span>{project.demoLabel}</span>
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
                              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                            </svg>
                          </a>
                        )}
                        <a
                          href={project.githubUrl}
                          class="flex items-center gap-1.5 px-4 py-2 border-2 border-elegant-white/30 text-elegant-off-white text-xs font-bold rounded-lg hover:border-elegant-white hover:bg-elegant-white/10 transition-all duration-300 hover:-translate-y-0.5"
                          aria-label="View source code"
                        >
                          <svg role="img" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4">
                            <path d={siGithub.path} />
                          </svg>
                          <span class="hidden sm:inline">Code</span>
                        </a>
                      </div>
                      {project.demoNote && (
                        <p class="text-elegant-off-white text-xs mt-2 font-medium">{project.demoNote}</p>
                      )}
                    </div>
                  )}

                  {project.status === 'upcoming' && (
                    <div class="pt-2">
                      <div class="px-4 py-2.5 bg-elegant-white/10 border-2 border-elegant-white/20 rounded-lg">
                        <p class="text-elegant-off-white font-medium text-sm">Currently in development</p>
                      </div>
                    </div>
                  )}
                </div>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
</ProjectsSectionAnimator>
