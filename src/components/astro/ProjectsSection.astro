---
import type { CollectionEntry } from 'astro:content';
import SectionEyebrow from '../ui/SectionEyebrow.astro';
import BrandGlyph from '../ui/BrandGlyph.astro';

interface Props {
  projects: CollectionEntry<'projects'>[];
}
const { projects } = Astro.props;

const sorted = [...projects].sort((a, b) => a.data.order - b.data.order);
const featured = sorted.filter((p) => p.data.featured);
const earlier = sorted.filter((p) => !p.data.featured);

const host = (url: string) => new URL(url).hostname.replace(/^www\./, '');
const isRepo = (url: string) => host(url) === 'github.com';
---

<section id="projects" aria-labelledby="projects-title">
  <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 sm:py-28 lg:px-8">
    <SectionEyebrow>Projects</SectionEyebrow>
    <div class="grid gap-6 lg:grid-cols-2 lg:items-end lg:gap-16">
      <h2
        id="projects-title"
        data-reveal
        class="mt-4 text-4xl leading-[1.05] font-bold tracking-[-0.025em] text-balance sm:text-5xl"
      >
        Things I've built and shipped.
      </h2>
      <p data-reveal style="--reveal-delay: 100ms" class="max-w-xl text-lg leading-relaxed text-quiet">
        From an RFID and IoT capstone to research tools and a magazine platform. Most are team projects,
        where I build features and often run project management and QA too.
      </p>
    </div>

    <ol class="mt-14 grid gap-6 sm:mt-20 md:grid-cols-2">
      {featured.map(({ data }, i) => (
        <li
          data-reveal
          style={`--reveal-delay: ${(i % 2) * 100}ms`}
          class="group flex flex-col rounded-[1.25rem] border border-line bg-surface p-6 shadow-[0_1px_0_var(--color-line),0_30px_60px_-30px_rgb(18_36_28/0.3)] transition-[border-color,box-shadow,translate] duration-300 ease-glide hover:-translate-y-0.5 hover:border-line-strong/50 hover:shadow-[0_1px_0_var(--color-line),0_40px_70px_-34px_rgb(18_36_28/0.45)] sm:p-8"
        >
          <article class="flex h-full flex-col" aria-labelledby={`project-${i}`}>
            <div class="flex items-start justify-between gap-4">
              <div class="flex flex-wrap items-center gap-2">
                <span class="rounded-full bg-evergreen-soft px-3 py-1 text-sm font-semibold text-evergreen">{data.kind}</span>
                {data.status === 'in-progress' && (
                  <span class="rounded-full bg-marigold-soft px-3 py-1 text-sm font-semibold text-marigold-text">In progress</span>
                )}
                {data.liveUrl && data.status === 'completed' && !isRepo(data.liveUrl) && (
                  <span class="inline-flex items-center gap-1.5 rounded-full border border-line px-3 py-1 text-sm font-semibold text-quiet">
                    <span class="size-1.5 rounded-full bg-evergreen" aria-hidden="true"></span>Live
                  </span>
                )}
              </div>
              <span class="font-display text-lg font-bold text-line-strong tabular-nums" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
            </div>

            <h3 id={`project-${i}`} class="mt-6 text-2xl leading-tight font-bold tracking-[-0.015em] sm:text-3xl">
              {data.title}
            </h3>
            <p class="mt-3 text-lg leading-relaxed text-quiet">{data.summary}</p>

            {(data.role || data.team) && (
              <dl class="mt-5 grid gap-1.5 text-[0.9375rem]">
                {data.role && (
                  <div class="flex gap-2">
                    <dt class="shrink-0 font-semibold">My role</dt>
                    <dd class="text-quiet">{data.role}</dd>
                  </div>
                )}
                {data.team && (
                  <div class="flex gap-2">
                    <dt class="shrink-0 font-semibold">Team</dt>
                    <dd class="text-quiet">{data.team}</dd>
                  </div>
                )}
              </dl>
            )}

            <ul class="mt-6 mb-8 flex flex-wrap gap-2" aria-label="Built with">
              {data.tags.map((tag) => (
                <li class="inline-flex items-center gap-1.5 rounded-full border border-line bg-mist-soft px-3 py-1 text-sm font-semibold">
                  <BrandGlyph name={tag} class="size-3.5 text-quiet" />
                  {tag}
                </li>
              ))}
            </ul>

            {(data.liveUrl || data.repoUrl) && (
              <div class="mt-auto flex flex-wrap gap-x-6 border-t border-line pt-4">
                {data.liveUrl && (
                  <a
                    href={data.liveUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex min-h-11 items-center gap-1.5 font-semibold text-evergreen underline-offset-4 hover:underline"
                  >
                    {isRepo(data.liveUrl) ? 'Download release' : `Visit ${host(data.liveUrl)}`}
                    <svg class="size-4 fill-none stroke-current stroke-2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M7 17 17 7M8 7h9v9" />
                    </svg>
                    <span class="sr-only">(opens in a new tab)</span>
                  </a>
                )}
                {data.repoUrl && (
                  <a
                    href={data.repoUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex min-h-11 items-center gap-1.5 font-semibold text-evergreen underline-offset-4 hover:underline"
                  >
                    <BrandGlyph name="GitHub" class="size-4" />
                    View on GitHub
                    <span class="sr-only">(opens in a new tab)</span>
                  </a>
                )}
              </div>
            )}
          </article>
        </li>
      ))}
    </ol>

    {earlier.length > 0 && (
      <div class="mt-16 sm:mt-20">
        <h3 data-reveal class="text-2xl font-bold tracking-[-0.01em]">Earlier work</h3>
        <ul data-reveal class="mt-5 divide-y divide-line overflow-hidden rounded-[1.25rem] border border-line bg-surface">
          {earlier.map(({ data }) => (
            <li class="grid gap-3 p-5 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-center sm:gap-8 sm:px-6">
              <div class="min-w-0">
                <p class="font-display text-lg font-bold">{data.title}</p>
                <p class="mt-1 leading-relaxed text-quiet">{data.summary}</p>
                <p class="mt-2 text-sm font-semibold text-quiet">{data.tags.join(' · ')}</p>
              </div>
              {data.repoUrl && (
                <a
                  href={data.repoUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex min-h-11 items-center gap-1.5 justify-self-start font-semibold text-evergreen underline-offset-4 hover:underline"
                >
                  <BrandGlyph name="GitHub" class="size-4" />
                  Code
                  <span class="sr-only">for {data.title} (opens in a new tab)</span>
                </a>
              )}
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>
</section>
