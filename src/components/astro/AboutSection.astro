---
import { render, type CollectionEntry } from 'astro:content';
import SectionEyebrow from '../ui/SectionEyebrow.astro';
import { inlineBold } from '../../lib/icons';

interface Props {
  entry: CollectionEntry<'info'>;
}
const { entry } = Astro.props;
const info = entry.data;
const { Content } = await render(entry);
const [topHighlight, ...otherHighlights] = info.highlights;
---

<section id="about" class="bg-surface" aria-labelledby="about-title">
  <div class="mx-auto max-w-7xl px-4 py-24 sm:px-6 sm:py-32 lg:px-8">
    <SectionEyebrow index="01">About</SectionEyebrow>
    <h2
      id="about-title"
      data-split
      class="mt-5 max-w-4xl text-[clamp(2.4rem,1.4rem+3.6vw,4.25rem)] leading-none font-bold tracking-[-0.035em] text-balance"
    >
      Mobile first. Full stack when the project needs it.
    </h2>

    <div class="mt-14 grid gap-14 sm:mt-20 lg:grid-cols-12 lg:gap-16">
      <!-- Bio: words fill in as you read down -->
      <div class="lg:col-span-7">
        <div
          data-scrub-words
          class="space-y-6 text-xl leading-[1.55] text-ink sm:text-2xl sm:leading-normal [&_strong]:font-semibold [&_strong]:text-evergreen"
        >
          <Content />
        </div>
        <p data-reveal class="mt-10 flex items-center gap-3 font-display text-lg font-semibold text-quiet">
          <span class="h-px w-8 bg-marigold" aria-hidden="true"></span>
          {info.tagline}
        </p>
      </div>

      <!-- At a glance -->
      <aside class="lg:col-span-5" aria-label="At a glance">
        <dl data-stagger class="divide-y divide-line border-y border-line">
          {info.education && (
            <div class="grid gap-1 py-5 sm:grid-cols-[7rem_1fr] sm:gap-6">
              <dt class="text-sm font-semibold text-quiet">Studying</dt>
              <dd>
                <span class="block font-semibold">{info.education.degree}</span>
                <span class="block text-quiet">{info.education.school}</span>
                <span class="mt-2 inline-flex rounded-full bg-evergreen-soft px-3 py-0.5 text-sm font-semibold text-evergreen">
                  {info.education.year}
                </span>
              </dd>
            </div>
          )}
          <div class="grid gap-1 py-5 sm:grid-cols-[7rem_1fr] sm:gap-6">
            <dt class="text-sm font-semibold text-quiet">Goal</dt>
            <dd class="font-semibold">{info.goal}</dd>
          </div>
          <div class="grid gap-1 py-5 sm:grid-cols-[7rem_1fr] sm:gap-6">
            <dt class="text-sm font-semibold text-quiet">Based in</dt>
            <dd class="font-semibold">{info.location}</dd>
          </div>
          <div class="grid gap-2 py-5 sm:grid-cols-[7rem_1fr] sm:gap-6">
            <dt class="text-sm font-semibold text-quiet">Into</dt>
            <dd>
              <ul class="flex flex-wrap gap-2">
                {info.interests.map((interest) => (
                  <li class="rounded-full border border-line bg-mist-soft px-3 py-1 text-sm font-semibold">{interest}</li>
                ))}
              </ul>
            </dd>
          </div>
        </dl>

        <blockquote data-reveal class="relative mt-8 rounded-3xl bg-marigold-soft p-6 sm:p-7">
          <svg class="absolute -top-4 left-6 size-9 fill-marigold" viewBox="0 0 32 32" aria-hidden="true">
            <path d="M13 8c-5 2-8 6-8 12v4h8v-8H9c0-3 2-5 5-6l-1-2Zm14 0c-5 2-8 6-8 12v4h8v-8h-4c0-3 2-5 5-6l-1-2Z" />
          </svg>
          <p class="font-display text-xl leading-snug font-semibold text-balance">{info.motto}</p>
          <footer class="mt-3 text-sm font-semibold text-marigold-text">My motto</footer>
        </blockquote>
      </aside>
    </div>

    <div class="mt-20 grid gap-6 sm:mt-28 lg:grid-cols-12">
      <!-- Right now -->
      <div data-reveal class="rounded-[1.75rem] bg-mist-soft p-6 sm:p-10 lg:col-span-7">
        <h3 class="flex items-center gap-3 text-2xl font-bold tracking-[-0.015em]">
          <span class="relative flex size-2.5" aria-hidden="true">
            <span class="absolute inline-flex size-full rounded-full bg-evergreen opacity-60 motion-safe:animate-ping"></span>
            <span class="relative inline-flex size-2.5 rounded-full bg-evergreen"></span>
          </span>
          Right now
        </h3>
        <ol data-stagger class="mt-6 divide-y divide-line">
          {info.rightNow.map((item, i) => (
            <li class="flex gap-5 py-4 leading-relaxed text-quiet">
              <span class="pt-0.5 font-display text-sm font-bold text-evergreen tabular-nums" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span set:html={inlineBold(item)} />
            </li>
          ))}
        </ol>
      </div>

      <!-- Highlights -->
      {topHighlight && (
        <div data-reveal data-reveal-delay="0.1" class="relative overflow-hidden rounded-[1.75rem] bg-night p-6 text-white sm:p-10 lg:col-span-5">
          <svg class="absolute -right-10 -bottom-10 size-56 fill-none stroke-white/6 stroke-[1.2]" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M8 21h8M12 17v4M7 4h10v5a5 5 0 0 1-10 0V4Z" />
            <path d="M17 6h2.5a1.5 1.5 0 0 1 1.5 1.5V8a4 4 0 0 1-4 4M7 6H4.5A1.5 1.5 0 0 0 3 7.5V8a4 4 0 0 0 4 4" />
          </svg>
          <h3 class="text-sm font-semibold tracking-wide text-marigold uppercase">Highlights</h3>
          <p class="mt-6 font-display text-3xl leading-tight font-bold tracking-[-0.02em] sm:text-4xl">{topHighlight.title}</p>
          <p class="mt-2 font-semibold text-white/80">{topHighlight.org} · {topHighlight.period}</p>
          <p class="mt-4 max-w-sm leading-relaxed text-white/70">{topHighlight.description}</p>

          {otherHighlights.length > 0 && (
            <ul class="relative mt-8 space-y-4 border-t border-white/10 pt-6">
              {otherHighlights.map((item) => (
                <li class="flex gap-3">
                  <span class="mt-2 size-2 shrink-0 rounded-full bg-level-2" aria-hidden="true"></span>
                  <div>
                    <p class="font-semibold">
                      {item.title} <span class="font-normal text-white/60">· {item.org}</span>
                    </p>
                    <p class="mt-1 text-sm leading-relaxed text-white/65">{item.description}</p>
                  </div>
                </li>
              ))}
            </ul>
          )}
        </div>
      )}
    </div>
  </div>
</section>
