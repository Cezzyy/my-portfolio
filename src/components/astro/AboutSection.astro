---
import { render, type CollectionEntry } from 'astro:content';
import SectionEyebrow from '../ui/SectionEyebrow.astro';
import { inlineBold } from '../../lib/icons';

interface Props {
  entry: CollectionEntry<'info'>;
}
const { entry } = Astro.props;
const info = entry.data;
const { Content } = await render(entry);
---

<section id="about" class="bg-surface" aria-labelledby="about-title">
  <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 sm:py-28 lg:px-8">
    <SectionEyebrow>About</SectionEyebrow>
    <div class="grid gap-6 lg:grid-cols-2 lg:items-end lg:gap-16">
      <h2
        id="about-title"
        data-reveal
        class="mt-4 text-4xl leading-[1.05] font-bold tracking-[-0.025em] text-balance sm:text-5xl"
      >
        Mobile first. Full stack when the project needs it.
      </h2>
      <p data-reveal style="--reveal-delay: 100ms" class="max-w-xl text-lg leading-relaxed text-quiet">
        {info.tagline}
      </p>
    </div>

    <div class="mt-14 grid gap-14 sm:mt-20 lg:grid-cols-[minmax(0,1fr)_minmax(0,26rem)] lg:gap-16">
      <div>
        <div
          data-reveal
          class="space-y-5 text-lg leading-relaxed text-quiet [&_strong]:font-semibold [&_strong]:text-ink"
        >
          <Content />
        </div>

        <h3 data-reveal class="mt-14 text-2xl font-bold tracking-[-0.01em]">Right now</h3>
        <ul class="mt-5 grid gap-2.5">
          {info.rightNow.map((item, i) => (
            <li
              data-reveal
              style={`--reveal-delay: ${i * 60}ms`}
              class="flex gap-3 rounded-control bg-mist-soft px-4 py-3.5 leading-relaxed text-quiet"
            >
              <svg class="mt-1 size-5 shrink-0 fill-none stroke-evergreen stroke-2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6" />
              </svg>
              <span set:html={inlineBold(item)} />
            </li>
          ))}
        </ul>
      </div>

      <aside class="space-y-5 lg:pt-1" aria-label="Education and highlights">
        {info.education && (
          <div data-reveal class="rounded-[1.25rem] border border-line bg-mist-soft p-6">
            <p class="text-sm font-semibold tracking-wide text-quiet uppercase">Education</p>
            <p class="mt-3 font-display text-xl font-bold">{info.education.degree}</p>
            <p class="mt-1 text-quiet">{info.education.school}</p>
            <p class="mt-4 inline-flex items-center gap-2 rounded-full bg-evergreen-soft px-3 py-1 text-sm font-semibold text-evergreen">
              {info.education.year}
            </p>
          </div>
        )}

        {info.highlights.length > 0 && (
          <div data-reveal style="--reveal-delay: 80ms" class="rounded-[1.25rem] border border-line bg-mist-soft p-6">
            <p class="text-sm font-semibold tracking-wide text-quiet uppercase">Highlights</p>
            <ol class="mt-4 space-y-5">
              {info.highlights.map((item, i) => (
                <li class="relative flex gap-4">
                  <span
                    class:list={[
                      'mt-1.5 size-3 shrink-0 rounded-full ring-4',
                      i === 0 ? 'bg-marigold ring-marigold-soft' : 'bg-level-2 ring-evergreen-soft',
                    ]}
                    aria-hidden="true"
                  ></span>
                  <div>
                    <p class="font-semibold">
                      {item.title} <span class="font-normal text-quiet">· {item.org}</span>
                    </p>
                    <p class="text-sm text-quiet">{item.period}</p>
                    <p class="mt-1.5 leading-relaxed text-quiet">{item.description}</p>
                  </div>
                </li>
              ))}
            </ol>
          </div>
        )}

        <div data-reveal style="--reveal-delay: 160ms" class="rounded-[1.25rem] border border-line bg-mist-soft p-6">
          <p class="text-sm font-semibold tracking-wide text-quiet uppercase">Interests</p>
          <ul class="mt-4 flex flex-wrap gap-2">
            {info.interests.map((interest) => (
              <li class="rounded-full border border-line bg-surface px-3 py-1 text-sm font-semibold">{interest}</li>
            ))}
          </ul>
        </div>
      </aside>
    </div>
  </div>
</section>
