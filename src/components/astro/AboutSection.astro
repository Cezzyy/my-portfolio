---
import { Image } from 'astro:assets';
import profilePic from "../../assets/profilepic.webp";
import { getEntry } from 'astro:content';
import AboutSectionAnimator from '../vue/animations/AboutSectionAnimator.vue';

const personalInfo = await getEntry('info', 'personal');
if (!personalInfo) {
    throw new Error('Personal information not found');
}
const { name, status, location, goal, currentFocus, interests, motto } = personalInfo.data;
---

<AboutSectionAnimator client:load>
<section id="about" class="relative min-h-screen py-16 lg:py-20 overflow-hidden bg-white">
  <!-- Creative Background Pattern -->
  <div class="absolute inset-0">
    <!-- Grid Pattern -->
    <div class="absolute inset-0 opacity-5">
      <div class="absolute inset-0" style="background-image: linear-gradient(rgba(0,0,0,.05) 1px, transparent 1px), linear-gradient(90deg, rgba(0,0,0,.05) 1px, transparent 1px); background-size: 50px 50px;"></div>
    </div>
    
    <!-- Gradient Overlay -->
    <div class="absolute inset-0 bg-gradient-to-br from-white via-gray-50 to-gray-100 opacity-90"></div>
    
    <!-- Floating Circles -->
    <div class="absolute top-20 right-20 w-64 h-64 bg-elegant-black/5 rounded-full blur-3xl"></div>
    <div class="absolute bottom-20 left-20 w-96 h-96 bg-elegant-black/3 rounded-full blur-3xl"></div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center mb-8 lg:mb-12">
      <h2 class="about-title text-3xl sm:text-4xl lg:text-5xl font-bold text-elegant-black mb-3">
        About Me
      </h2>
      <div class="about-underline w-20 h-1 bg-elegant-black mx-auto"></div>
    </div>

    <!-- Main Content Grid -->
    <div class="grid md:grid-cols-2 gap-6 lg:gap-10 items-center">
      <!-- Left Column - Information -->
      <div class="about-content">
        <div class="bg-white/80 backdrop-blur-lg rounded-xl p-5 lg:p-7 border border-elegant-black/10 shadow-2xl space-y-4">
          <div class="mb-4">
            <h3 class="text-xl lg:text-2xl font-bold text-elegant-black mb-1">{name}</h3>
            <p class="text-base lg:text-lg text-elegant-dark-gray font-semibold mb-2">{status}</p>
            <div class="flex items-center gap-2 text-elegant-dark-gray mb-3 text-sm">
              <svg class="w-4 h-4 text-elegant-black flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
              <span>{location}</span>
            </div>
          </div>

          <div class="space-y-3 text-elegant-dark-gray">
            <p class="text-sm lg:text-base leading-relaxed">
              {goal}. Currently exploring the exciting world of cross-platform
              development while building my skills across the full stack.
            </p>

            <p class="text-sm leading-relaxed italic text-elegant-soft-gray">
              "{motto}"
            </p>
          </div>

          <div class="pt-3">
            <h4 class="text-base lg:text-lg font-bold text-elegant-black mb-2">Current Focus</h4>
            <div class="flex flex-wrap gap-2">
              {currentFocus.map((tech) => (
                <span class="px-3 py-1.5 bg-elegant-black/5 border border-elegant-black/20 rounded-lg text-elegant-dark-gray font-medium text-xs hover:bg-elegant-black/10 transition-colors">
                  {tech}
                </span>
              ))}
            </div>
          </div>

          <div class="pt-3">
            <h4 class="text-base lg:text-lg font-bold text-elegant-black mb-2">Interests</h4>
            <ul class="space-y-2">
              {interests.map((interest) => (
                <li class="flex items-center gap-2 text-elegant-dark-gray text-sm lg:text-base">
                  <div class="w-2 h-2 bg-elegant-black rounded-full flex-shrink-0"></div>
                  <span>{interest}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>

      <!-- Right Column - Profile Picture -->
      <div class="profile-image flex items-center justify-center mt-6 md:mt-0">
        <div class="relative">
          <!-- Decorative Ring 1 -->
          <div class="absolute inset-0 rounded-full border-4 border-elegant-black/20 animate-pulse-ring"></div>

          <!-- Decorative Ring 2 -->
          <div class="absolute inset-0 rounded-full border-4 border-elegant-black/10 animate-pulse-ring-delayed" style="animation-delay: 0.5s;"></div>

          <!-- Profile Picture Container -->
          <div class="relative w-64 h-64 lg:w-80 lg:h-80 rounded-full overflow-hidden border-4 border-elegant-black/30 shadow-2xl shadow-elegant-black/10">
            <Image
              src={profilePic}
              alt={name}
              class="w-full h-full object-cover grayscale hover:grayscale-0 transition-all duration-500"
              loading="lazy"
              width={320}
              height={320}
              quality={90}
            />
          </div>

          <!-- Corner Accent -->
          <div class="absolute -bottom-3 -right-3 w-16 h-16 bg-elegant-black rounded-full flex items-center justify-center shadow-lg">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path>
            </svg>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
</AboutSectionAnimator>

<style>
  @keyframes pulse-ring {
    0%, 100% {
      transform: scale(1);
      opacity: 0.3;
    }
    50% {
      transform: scale(1.1);
      opacity: 0.1;
    }
  }

  @keyframes pulse-ring-delayed {
    0%, 100% {
      transform: scale(1);
      opacity: 0.2;
    }
    50% {
      transform: scale(1.15);
      opacity: 0.05;
    }
  }

  .animate-pulse-ring {
    animation: pulse-ring 3s ease-in-out infinite;
  }

  .animate-pulse-ring-delayed {
    animation: pulse-ring-delayed 3s ease-in-out infinite;
  }
</style>
