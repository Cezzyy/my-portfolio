---
import LogoMark from '../ui/LogoMark.astro';

interface Props {
  nickname: string;
}
const { nickname } = Astro.props;

const navItems = [
  { label: 'About', href: '#about' },
  { label: 'Projects', href: '#projects' },
  { label: 'Stack', href: '#stack' },
  { label: 'Contact', href: '#contact' },
];
---

<header class="sticky top-0 z-40 h-header border-b border-line bg-mist/90 backdrop-blur">
  <nav
    aria-label="Main"
    class="mx-auto flex h-full w-full max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8"
  >
    <a href="#top" class="flex min-h-11 items-center gap-2.5 font-display text-xl font-bold text-evergreen">
      <LogoMark class="size-8" />
      {nickname}
    </a>

    <div class="flex items-center gap-1">
      {navItems.map((item) => (
        <a
          href={item.href}
          data-nav
          class="hidden min-h-11 items-center rounded-control px-3 font-semibold text-quiet transition-colors hover:text-ink aria-[current=true]:text-evergreen md:inline-flex"
        >
          {item.label}
        </a>
      ))}

      <button
        type="button"
        id="theme-toggle"
        class="grid size-11 place-items-center rounded-control text-quiet transition-colors hover:bg-evergreen-soft hover:text-evergreen"
        aria-label="Switch to dark theme"
      >
        <!-- Moon shows in light theme, sun in dark; swapped by the [data-icon] rules below. -->
        <svg data-icon="moon" class="size-5 fill-none stroke-current stroke-2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
        </svg>
        <svg data-icon="sun" class="size-5 fill-none stroke-current stroke-2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
      </button>

      <a
        href="#contact"
        class="ml-1 hidden min-h-11 items-center rounded-control border border-line-strong px-4 font-semibold text-evergreen transition-colors hover:bg-evergreen-soft sm:inline-flex"
      >
        Get in touch
      </a>

      <button
        type="button"
        id="menu-toggle"
        class="grid size-11 place-items-center rounded-control text-ink transition-colors hover:bg-evergreen-soft md:hidden"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label="Open menu"
      >
        <svg class="size-6 fill-none stroke-current stroke-2" viewBox="0 0 24 24" stroke-linecap="round" aria-hidden="true">
          <path data-menu="open" d="M4 7h16M4 12h16M4 17h16" />
          <path data-menu="close" d="M6 6l12 12M18 6 6 18" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- Reading progress, scrubbed by src/scripts/motion. Inline transform so GSAP owns it. -->
  <div
    data-progress
    class="absolute inset-x-0 -bottom-px h-0.5 origin-left bg-marigold"
    style="transform: scaleX(0)"
    aria-hidden="true"
  >
  </div>

  <div id="mobile-menu" class="hidden border-b border-line bg-surface shadow-[0_18px_36px_-24px_rgb(18_36_28/0.45)] md:hidden">
    <ul class="mx-auto max-w-7xl px-4 py-3 sm:px-6">
      {navItems.map((item) => (
        <li>
          <a href={item.href} class="flex min-h-12 items-center rounded-control px-3 text-lg font-semibold text-ink hover:bg-evergreen-soft">
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<style>
  [data-icon='sun'],
  [data-menu='close'] {
    display: none;
  }
  #menu-toggle[aria-expanded='true'] [data-menu='open'] {
    display: none;
  }
  #menu-toggle[aria-expanded='true'] [data-menu='close'] {
    display: block;
  }
  :global(:root[data-theme='dark']) [data-icon='sun'] {
    display: block;
  }
  :global(:root[data-theme='dark']) [data-icon='moon'] {
    display: none;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) [data-icon='sun'] {
      display: block;
    }
    :global(:root:not([data-theme='light'])) [data-icon='moon'] {
      display: none;
    }
  }
</style>

<script>
  const root = document.documentElement;

  // Theme toggle: flips whatever is showing now, and remembers the choice.
  const themeToggle = document.getElementById('theme-toggle')!;
  const prefersDark = window.matchMedia('(prefers-color-scheme: dark)');
  const isDark = () => (root.dataset.theme ? root.dataset.theme === 'dark' : prefersDark.matches);
  const syncLabel = () =>
    themeToggle.setAttribute('aria-label', isDark() ? 'Switch to light theme' : 'Switch to dark theme');

  syncLabel();
  prefersDark.addEventListener('change', syncLabel);
  themeToggle.addEventListener('click', () => {
    const next = isDark() ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
    syncLabel();
  });

  // Mobile menu.
  const menuToggle = document.getElementById('menu-toggle')!;
  const menu = document.getElementById('mobile-menu')!;
  const setMenu = (open: boolean) => {
    menu.classList.toggle('hidden', !open);
    menuToggle.setAttribute('aria-expanded', String(open));
    menuToggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  };
  menuToggle.addEventListener('click', () => setMenu(menu.classList.contains('hidden')));
  menu.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenu(false)));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && setMenu(false));

  // Highlight the nav link for the section in the middle of the screen.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav]')];
  const sections = links
    .map((link) => document.querySelector<HTMLElement>(link.hash))
    .filter((el): el is HTMLElement => el !== null);
  const spy = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        links.forEach((link) => link.setAttribute('aria-current', String(link.hash === `#${entry.target.id}`)));
      }
    },
    { rootMargin: '-45% 0px -50% 0px' },
  );
  sections.forEach((section) => spy.observe(section));
</script>
