---
import largeTriangles from "../../assets/large-triangles.svg";
import { getEntry } from 'astro:content';
import ContactSectionAnimator from '../vue/animations/ContactSectionAnimator.vue';
import { siGithub, siFacebook } from 'simple-icons';

const personalInfo = await getEntry('info', 'personal');
if (!personalInfo) {
    throw new Error('Personal information not found');
}
const { name, location } = personalInfo.data;
---

<ContactSectionAnimator client:load>
<section id="contact" class="relative min-h-screen py-16 lg:py-20 overflow-hidden">
  <!-- Background SVG -->
  <div class="absolute inset-0">
    <img
      src={largeTriangles.src}
      alt=""
      class="w-full h-full object-cover"
      loading="lazy"
    />
  </div>

  <!-- Gradient Overlay -->
  <div class="absolute inset-0 bg-gradient-to-b from-deep-forest-950/90 via-deep-forest/80 to-medium-jungle-900/90"></div>

  <!-- Floating Geometric Shapes -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div class="contact-shape shape-1"></div>
    <div class="contact-shape shape-2"></div>
    <div class="contact-shape shape-3"></div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center mb-8 lg:mb-12">
      <h2 class="contact-title text-3xl sm:text-4xl lg:text-5xl font-bold text-turf-green-50 mb-3">
        Get In Touch
      </h2>
      <div class="contact-underline w-20 h-1 bg-gradient-to-r from-forest-green to-emerald mx-auto mb-3"></div>
      <p class="contact-subtitle text-sm lg:text-base text-turf-green-100 max-w-2xl mx-auto px-2">
        Have a project in mind or want to collaborate? I'd love to hear from you.
      </p>
    </div>

    <!-- Info Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8 lg:mb-10">
      <!-- Email Card -->
      <div class="contact-info-card bg-deep-forest-950/95 backdrop-blur-lg rounded-xl p-5 border border-turf-green/20 shadow-2xl text-center transition-all duration-300 hover:border-forest-green/40 hover:shadow-forest-green/20 hover:-translate-y-1">
        <div class="w-12 h-12 mx-auto mb-3 bg-gradient-to-br from-forest-green/20 to-emerald/20 border border-forest-green/30 rounded-xl flex items-center justify-center">
          <svg class="w-6 h-6 text-forest-green" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
          </svg>
        </div>
        <h3 class="text-base font-bold text-turf-green-100 mb-1">Email</h3>
        <a href="mailto:casupananjohncez@gmail.com" class="text-turf-green-200 text-xs hover:text-forest-green transition-colors break-all">
          casupananjohncez@gmail.com
        </a>
      </div>

      <!-- Location Card -->
      <div class="contact-info-card bg-deep-forest-950/95 backdrop-blur-lg rounded-xl p-5 border border-turf-green/20 shadow-2xl text-center transition-all duration-300 hover:border-forest-green/40 hover:shadow-forest-green/20 hover:-translate-y-1">
        <div class="w-12 h-12 mx-auto mb-3 bg-gradient-to-br from-forest-green/20 to-emerald/20 border border-forest-green/30 rounded-xl flex items-center justify-center">
          <svg class="w-6 h-6 text-forest-green" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
          </svg>
        </div>
        <h3 class="text-base font-bold text-turf-green-100 mb-1">Location</h3>
        <p class="text-turf-green-200 text-xs">{location}</p>
      </div>

      <!-- Socials Card -->
      <div class="contact-info-card bg-deep-forest-950/95 backdrop-blur-lg rounded-xl p-5 border border-turf-green/20 shadow-2xl text-center transition-all duration-300 hover:border-forest-green/40 hover:shadow-forest-green/20 hover:-translate-y-1">
        <div class="w-12 h-12 mx-auto mb-3 bg-gradient-to-br from-forest-green/20 to-emerald/20 border border-forest-green/30 rounded-xl flex items-center justify-center">
          <svg class="w-6 h-6 text-forest-green" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path>
          </svg>
        </div>
        <h3 class="text-base font-bold text-turf-green-100 mb-1">Socials</h3>
        <div class="flex justify-center gap-2 mt-2">
          <a href="https://github.com/Cezzyy" target="_blank" rel="noopener noreferrer" class="contact-social-link social-icon" aria-label="GitHub Profile">
            <svg class="w-4 h-4" fill="currentColor" role="img" viewBox="0 0 24 24">
              <path d={siGithub.path} />
            </svg>
          </a>
          <a href="https://www.linkedin.com/in/john-cez-casupanan-07196027b/" target="_blank" rel="noopener noreferrer" class="contact-social-link social-icon" aria-label="LinkedIn Profile">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </a>
          <a href="https://www.facebook.com/john.cez.casupanan04" target="_blank" rel="noopener noreferrer" class="contact-social-link social-icon" aria-label="Facebook Profile">
            <svg class="w-4 h-4" fill="currentColor" role="img" viewBox="0 0 24 24">
              <path d={siFacebook.path} />
            </svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Contact Form -->
    <div class="contact-form-card max-w-3xl mx-auto bg-deep-forest-950/95 backdrop-blur-lg rounded-xl p-5 lg:p-7 border border-turf-green/20 shadow-2xl">
      <h3 class="text-lg lg:text-xl font-bold text-turf-green-100 mb-5 text-center">
        Send Me a Message
      </h3>
      <form id="contact-form" class="space-y-4" action="https://formspree.io/f/your-form-id" method="POST">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="contact-name" class="block text-xs font-medium text-turf-green-200 mb-1.5">Name</label>
            <input
              type="text"
              id="contact-name"
              name="name"
              required
              placeholder="Your name"
              class="w-full px-3 py-2 bg-deep-forest-900/80 border border-turf-green/20 rounded-lg text-turf-green-100 text-sm placeholder-turf-green-600 focus:outline-none focus:border-forest-green focus:ring-1 focus:ring-forest-green transition-colors"
            />
          </div>
          <div>
            <label for="contact-email" class="block text-xs font-medium text-turf-green-200 mb-1.5">Email</label>
            <input
              type="email"
              id="contact-email"
              name="email"
              required
              placeholder="your@email.com"
              class="w-full px-3 py-2 bg-deep-forest-900/80 border border-turf-green/20 rounded-lg text-turf-green-100 text-sm placeholder-turf-green-600 focus:outline-none focus:border-forest-green focus:ring-1 focus:ring-forest-green transition-colors"
            />
          </div>
        </div>
        <div>
          <label for="contact-subject" class="block text-xs font-medium text-turf-green-200 mb-1.5">Subject</label>
          <input
            type="text"
            id="contact-subject"
            name="subject"
            required
            placeholder="What's this about?"
            class="w-full px-3 py-2 bg-deep-forest-900/80 border border-turf-green/20 rounded-lg text-turf-green-100 text-sm placeholder-turf-green-600 focus:outline-none focus:border-forest-green focus:ring-1 focus:ring-forest-green transition-colors"
          />
        </div>
        <div>
          <label for="contact-message" class="block text-xs font-medium text-turf-green-200 mb-1.5">Message</label>
          <textarea
            id="contact-message"
            name="message"
            required
            rows="4"
            placeholder="Tell me about your project or idea..."
            class="w-full px-3 py-2 bg-deep-forest-900/80 border border-turf-green/20 rounded-lg text-turf-green-100 text-sm placeholder-turf-green-600 focus:outline-none focus:border-forest-green focus:ring-1 focus:ring-forest-green transition-colors resize-none"
          ></textarea>
        </div>
        <div class="text-center pt-2">
          <button
            type="submit"
            class="group inline-flex items-center gap-2 px-6 py-2.5 bg-gradient-to-r from-forest-green-700 to-medium-jungle-700 text-white font-semibold text-sm rounded-lg transition-all duration-300 transform hover:scale-105 hover:shadow-2xl hover:shadow-forest-green-700/30 relative overflow-hidden"
          >
            <span class="relative z-10">Send Message</span>
            <svg class="relative z-10 w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
            </svg>
            <div class="absolute inset-0 bg-gradient-to-r from-medium-jungle-700 to-forest-green-700 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
          </button>
        </div>
      </form>
    </div>

    <!-- Footer -->
    <div class="mt-10 lg:mt-12 text-center">
      <p class="text-turf-green-200 text-xs">
        &copy; {new Date().getFullYear()} {name}. Built with
        <span class="text-forest-green">Astro</span>,
        <span class="text-forest-green">Vue</span> &
        <span class="text-forest-green">TailwindCSS</span>.
      </p>
    </div>
  </div>
</section>
</ContactSectionAnimator>

<style>
  /* Floating Shapes */
  .contact-shape {
    position: absolute;
    background: linear-gradient(135deg, rgba(57, 198, 71, 0.1), rgba(75, 180, 98, 0.1));
    border-radius: 50%;
    animation: contactFloat 25s infinite ease-in-out;
    opacity: 0;
    transform: scale(0.8);
  }

  .shape-1 {
    width: 220px;
    height: 220px;
    top: 15%;
    left: 8%;
    animation-delay: 0s;
  }

  .shape-2 {
    width: 180px;
    height: 180px;
    bottom: 20%;
    right: 10%;
    animation-delay: 3s;
  }

  .shape-3 {
    width: 150px;
    height: 150px;
    top: 50%;
    right: 5%;
    animation-delay: 6s;
  }

  @keyframes contactFloat {
    0%, 100% {
      transform: translateY(0) rotate(0deg) scale(0.8);
      opacity: 0.1;
    }
    25% {
      transform: translateY(-20px) rotate(90deg) scale(1);
      opacity: 0.2;
    }
    50% {
      transform: translateY(-10px) rotate(180deg) scale(0.9);
      opacity: 0.15;
    }
    75% {
      transform: translateY(-30px) rotate(270deg) scale(1.1);
      opacity: 0.25;
    }
  }

  /* Social Icons */
  .social-icon {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    background: rgba(145, 212, 154, 0.15);
    border: 2px solid #91d49a;
    color: #91d49a;
    transition: all 0.3s ease;
  }

  .social-icon:hover {
    background: #91d49a;
    color: #0f2414;
    transform: translateY(-3px);
    box-shadow: 0 6px 12px rgba(145, 212, 154, 0.4);
  }

  /* Initial states for GSAP animations */
  .contact-title,
  .contact-subtitle,
  .contact-info-card,
  .contact-form-card,
  .contact-social-link {
    opacity: 0;
    transform: translateY(30px);
  }

  .contact-underline {
    opacity: 0;
    transform: scaleX(0);
  }
</style>
