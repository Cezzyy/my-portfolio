---
import { getEntry } from 'astro:content';
import ContactSectionAnimator from '../vue/animations/ContactSectionAnimator.vue';
import { siGithub, siFacebook } from 'simple-icons';

const personalInfo = await getEntry('info', 'personal');
if (!personalInfo) {
    throw new Error('Personal information not found');
}
const { name, location } = personalInfo.data;
---

<ContactSectionAnimator client:load>
<section id="contact" class="relative min-h-screen py-16 lg:py-20 overflow-hidden bg-elegant-black">
  <!-- Creative Background -->
  <div class="absolute inset-0">
    <!-- Hexagon Pattern -->
    <div class="absolute inset-0 opacity-5">
      <div class="absolute inset-0" style="background-image: repeating-linear-gradient(0deg, transparent, transparent 50px, rgba(255,255,255,.1) 50px, rgba(255,255,255,.1) 100px), repeating-linear-gradient(90deg, transparent, transparent 50px, rgba(255,255,255,.1) 50px, rgba(255,255,255,.1) 100px);"></div>
    </div>
    
    <!-- Gradient Overlay -->
    <div class="absolute inset-0 bg-gradient-to-b from-elegant-black via-elegant-dark-gray/30 to-elegant-black opacity-95"></div>
    
    <!-- Floating Shapes -->
    <div class="absolute top-20 left-10 w-80 h-80 bg-elegant-white/5 rounded-full blur-3xl"></div>
    <div class="absolute bottom-20 right-10 w-96 h-96 bg-elegant-white/3 rounded-full blur-3xl"></div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center mb-12 lg:mb-16">
      <h2 class="contact-title text-3xl sm:text-4xl lg:text-5xl font-bold text-elegant-white mb-3">
        Get In Touch
      </h2>
      <div class="contact-underline w-20 h-1 bg-elegant-white mx-auto mb-3"></div>
      <p class="contact-subtitle text-sm lg:text-base text-elegant-off-white max-w-2xl mx-auto px-2">
        Have a project in mind or want to collaborate? I'd love to hear from you.
      </p>
    </div>

    <!-- Two Column Layout -->
    <div class="grid lg:grid-cols-2 gap-8 lg:gap-12 items-start">
      
      <!-- Left Side - Contact Information -->
      <div class="contact-info-side space-y-8">
        <!-- Intro Text -->
        <div>
          <h3 class="text-2xl lg:text-3xl font-bold text-elegant-white mb-4">
            Let's work together
          </h3>
          <p class="text-elegant-off-white text-sm lg:text-base leading-relaxed">
            I'm always interested in hearing about new projects and opportunities. Whether you have a question or just want to say hi, feel free to reach out.
          </p>
        </div>

        <!-- Contact Details -->
        <div class="space-y-4">
          <!-- Email -->
          <div class="contact-info-item flex items-start gap-4 group">
            <div class="w-12 h-12 flex-shrink-0 bg-elegant-white/5 border border-elegant-white/20 rounded-xl flex items-center justify-center group-hover:bg-elegant-white/10 transition-all duration-300">
              <svg class="w-6 h-6 text-elegant-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
              </svg>
            </div>
            <div class="flex-1">
              <h4 class="text-sm font-semibold text-elegant-white mb-1">Email</h4>
              <a href="mailto:casupananjohncez@gmail.com" class="text-elegant-off-white text-sm hover:text-elegant-white transition-colors break-all">
                casupananjohncez@gmail.com
              </a>
            </div>
          </div>

          <!-- Phone -->
          <div class="contact-info-item flex items-start gap-4 group">
            <div class="w-12 h-12 flex-shrink-0 bg-elegant-white/5 border border-elegant-white/20 rounded-xl flex items-center justify-center group-hover:bg-elegant-white/10 transition-all duration-300">
              <svg class="w-6 h-6 text-elegant-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
              </svg>
            </div>
            <div class="flex-1">
              <h4 class="text-sm font-semibold text-elegant-white mb-1">Phone</h4>
              <a href="tel:+639682018381" class="text-elegant-off-white text-sm hover:text-elegant-white transition-colors">
                +63 968 201 8381
              </a>
            </div>
          </div>

          <!-- Location -->
          <div class="contact-info-item flex items-start gap-4 group">
            <div class="w-12 h-12 flex-shrink-0 bg-elegant-white/5 border border-elegant-white/20 rounded-xl flex items-center justify-center group-hover:bg-elegant-white/10 transition-all duration-300">
              <svg class="w-6 h-6 text-elegant-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
            </div>
            <div class="flex-1">
              <h4 class="text-sm font-semibold text-elegant-white mb-1">Location</h4>
              <p class="text-elegant-off-white text-sm">{location}</p>
            </div>
          </div>
        </div>

        <!-- Social Links -->
        <div>
          <h4 class="pt-6 text-sm font-semibold text-elegant-white mb-4">Connect with me</h4>
          <div class="flex gap-3">
            <a href="https://github.com/Cezzyy" target="_blank" rel="noopener noreferrer" class="contact-social-link social-icon" aria-label="GitHub Profile">
              <svg class="w-5 h-5" fill="currentColor" role="img" viewBox="0 0 24 24">
                <path d={siGithub.path} />
              </svg>
            </a>
            <a href="https://www.linkedin.com/in/john-cez-casupanan-07196027b/" target="_blank" rel="noopener noreferrer" class="contact-social-link social-icon" aria-label="LinkedIn Profile">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
            </a>
            <a href="https://www.facebook.com/john.cez.casupanan04" target="_blank" rel="noopener noreferrer" class="contact-social-link social-icon" aria-label="Facebook Profile">
              <svg class="w-5 h-5" fill="currentColor" role="img" viewBox="0 0 24 24">
                <path d={siFacebook.path} />
              </svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Right Side - Contact Form -->
      <div class="contact-form-card bg-elegant-dark-gray/40 backdrop-blur-lg rounded-2xl p-6 lg:p-8 border border-elegant-white/10 shadow-2xl">
        <h3 class="text-xl lg:text-2xl font-bold text-elegant-white mb-6">
          Send a Message
        </h3>
        <form id="contact-form" class="space-y-5" action="https://formspree.io/f/your-form-id" method="POST">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label for="contact-name" class="block text-sm font-medium text-elegant-off-white mb-2">Name</label>
              <input
                type="text"
                id="contact-name"
                name="name"
                required
                placeholder="John Doe"
                class="w-full px-4 py-3 bg-elegant-black/40 border border-elegant-white/20 rounded-lg text-elegant-off-white text-sm placeholder-elegant-soft-gray focus:outline-none focus:border-elegant-white focus:ring-2 focus:ring-elegant-white/20 transition-all"
              />
            </div>
            <div>
              <label for="contact-email" class="block text-sm font-medium text-elegant-off-white mb-2">Email</label>
              <input
                type="email"
                id="contact-email"
                name="email"
                required
                placeholder="john@example.com"
                class="w-full px-4 py-3 bg-elegant-black/40 border border-elegant-white/20 rounded-lg text-elegant-off-white text-sm placeholder-elegant-soft-gray focus:outline-none focus:border-elegant-white focus:ring-2 focus:ring-elegant-white/20 transition-all"
              />
            </div>
          </div>
          <div>
            <label for="contact-subject" class="block text-sm font-medium text-elegant-off-white mb-2">Subject</label>
            <input
              type="text"
              id="contact-subject"
              name="subject"
              required
              placeholder="Project Inquiry"
              class="w-full px-4 py-3 bg-elegant-black/40 border border-elegant-white/20 rounded-lg text-elegant-off-white text-sm placeholder-elegant-soft-gray focus:outline-none focus:border-elegant-white focus:ring-2 focus:ring-elegant-white/20 transition-all"
            />
          </div>
          <div>
            <label for="contact-message" class="block text-sm font-medium text-elegant-off-white mb-2">Message</label>
            <textarea
              id="contact-message"
              name="message"
              required
              rows="5"
              placeholder="Tell me about your project..."
              class="w-full px-4 py-3 bg-elegant-black/40 border border-elegant-white/20 rounded-lg text-elegant-off-white text-sm placeholder-elegant-soft-gray focus:outline-none focus:border-elegant-white focus:ring-2 focus:ring-elegant-white/20 transition-all resize-none"
            ></textarea>
          </div>
          <div class="pt-2">
            <button
              type="submit"
              class="group w-full inline-flex items-center justify-center gap-2 px-6 py-3.5 bg-elegant-white hover:bg-elegant-off-white text-elegant-black font-semibold text-sm rounded-lg transition-all duration-300 transform hover:scale-[1.02] hover:shadow-2xl hover:shadow-elegant-white/30"
            >
              <span>Send Message</span>
              <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
              </svg>
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- Footer -->
    <div class="mt-16 lg:mt-20 text-center border-t border-elegant-white/10 pt-8">
      <p class="text-elegant-soft-gray text-xs">
        &copy; {new Date().getFullYear()} {name}. Built with
        <span class="text-elegant-off-white">Astro</span>,
        <span class="text-elegant-off-white">Vue</span> &
        <span class="text-elegant-off-white">TailwindCSS</span>.
      </p>
    </div>
  </div>
</section>
</ContactSectionAnimator>

<style>
  /* Social Icons */
  .social-icon {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.05);
    border: 2px solid rgba(255, 255, 255, 0.2);
    color: #ffffff;
    transition: all 0.3s ease;
  }

  .social-icon:hover {
    background: #ffffff;
    color: #0a0a0a;
    transform: translateY(-3px);
    box-shadow: 0 6px 12px rgba(255, 255, 255, 0.3);
    border-color: #ffffff;
  }

  /* Initial states for GSAP animations */
  .contact-title,
  .contact-subtitle,
  .contact-info-side,
  .contact-info-item,
  .contact-form-card,
  .contact-social-link {
    opacity: 0;
    transform: translateY(30px);
  }

  .contact-underline {
    opacity: 0;
    transform: scaleX(0);
  }
</style>
