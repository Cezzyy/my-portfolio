---
import type { CollectionEntry } from 'astro:content';
import SectionEyebrow from '../ui/SectionEyebrow.astro';
import BrandGlyph from '../ui/BrandGlyph.astro';
import ContactForm from '../vue/ContactForm.vue';

interface Props {
  info: CollectionEntry<'info'>['data'];
}
const { info } = Astro.props;

const channels = [
  {
    label: 'Email',
    value: info.email,
    href: `mailto:${info.email}`,
    icon: ['M3 7l9 6 9-6', 'M5 5h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2Z'],
  },
  ...(info.phone
    ? [
        {
          label: 'Phone',
          value: info.phone,
          href: `tel:${info.phone.replace(/\s+/g, '')}`,
          icon: ['M5 4h3l2 5-2.5 1.5a11 11 0 0 0 6 6L15 14l5 2v3a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z'],
        },
      ]
    : []),
  {
    label: 'Based in',
    value: info.location,
    href: null,
    icon: ['M12 21s-7-5.5-7-11a7 7 0 0 1 14 0c0 5.5-7 11-7 11Z', 'M12 12.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z'],
  },
];
---

<section id="contact" class="bg-brand text-white" aria-labelledby="contact-title">
  <div class="mx-auto grid max-w-7xl gap-14 px-4 py-20 sm:px-6 sm:py-28 lg:grid-cols-2 lg:gap-20 lg:px-8">
    <div>
      <SectionEyebrow class="text-marigold">Contact</SectionEyebrow>
      <h2 id="contact-title" data-reveal class="mt-4 text-4xl leading-[1.05] font-bold tracking-[-0.025em] text-balance sm:text-5xl">
        Let's build something together.
      </h2>
      <p data-reveal style="--reveal-delay: 100ms" class="mt-6 max-w-lg text-lg leading-relaxed text-white/80">
        I'm open to internships, freelance work and collaborations. Send a message, or reach me directly.
      </p>

      <ul class="mt-10 space-y-6">
        {channels.map((channel, i) => (
          <li data-reveal style={`--reveal-delay: ${150 + i * 60}ms`} class="flex gap-4">
            <span class="grid size-11 shrink-0 place-items-center rounded-full bg-white/10" aria-hidden="true">
              <svg class="size-5 fill-none stroke-marigold stroke-2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                {channel.icon.map((d) => <path d={d} />)}
              </svg>
            </span>
            <div class="min-w-0 pt-0.5">
              <p class="text-sm text-white/60">{channel.label}</p>
              {channel.href ? (
                <a
                  href={channel.href}
                  class="font-semibold break-words text-white underline decoration-white/30 underline-offset-4 hover:decoration-white"
                >
                  {channel.value}
                </a>
              ) : (
                <p class="font-semibold">{channel.value}</p>
              )}
            </div>
          </li>
        ))}
      </ul>

      <ul data-reveal style="--reveal-delay: 350ms" class="mt-10 flex flex-wrap gap-2" aria-label="Social profiles">
        {info.socials.map((social) => (
          <li>
            <a
              href={social.url}
              target="_blank"
              rel="noopener noreferrer"
              class="grid size-11 place-items-center rounded-control bg-white/10 text-white transition-colors hover:bg-white/20"
            >
              <BrandGlyph name={social.label} class="size-5" />
              <span class="sr-only">{social.label} (opens in a new tab)</span>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div
      data-reveal
      style="--reveal-delay: 120ms"
      class="self-start rounded-[1.25rem] bg-surface p-6 text-ink shadow-[0_30px_60px_-30px_rgb(0_0_0/0.6)] sm:p-10"
    >
      <h3 class="text-2xl font-bold tracking-[-0.01em]">Send a message</h3>
      <p class="mt-2 text-quiet">I usually reply within a couple of days.</p>
      <div class="mt-8">
        <ContactForm client:visible />
      </div>
    </div>
  </div>
</section>
