---
/**
 * Abstract device mock for a project card: a phone for mobile builds, a browser window for web
 * builds. It's decoration (the card carries the real content), so it's hidden from assistive tech.
 * Pieces marked data-mock-piece build in one by one (src/scripts/motion/projects.ts).
 */
import BrandGlyph from './BrandGlyph.astro';
import { glyphFor } from '../../lib/icons';

interface Props {
  variant: 'phone' | 'browser';
  name: string;
  tags: string[];
  host?: string | null;
}
const { variant, name, tags, host } = Astro.props;
const initial = name.trim().charAt(0).toUpperCase();
const glyphTags = tags.filter((tag) => glyphFor(tag)).slice(0, 3);
const bar = 'block rounded-full';
---

{variant === 'phone' ? (
  <div
    data-mock
    aria-hidden="true"
    class="relative w-44 shrink-0 -rotate-[5deg] rounded-[2.4rem] bg-[#12241c] p-[7px] shadow-[0_40px_70px_-30px_rgb(18_36_28/0.65)] ring-1 ring-white/10 sm:w-52"
  >
    <div class="relative aspect-[9/19] overflow-hidden rounded-[2rem] bg-surface">
      <span class="absolute top-2 left-1/2 h-[1.1rem] w-[4.25rem] -translate-x-1/2 rounded-full bg-[#12241c]"></span>
      <div class="flex h-full flex-col px-3.5 pt-10 pb-3">
        <div data-mock-piece class="flex items-center gap-2">
          <span class="grid size-8 shrink-0 place-items-center rounded-[0.6rem] bg-evergreen font-display text-sm font-bold text-on-evergreen">
            {initial}
          </span>
          <span class="min-w-0 truncate font-display text-sm font-bold">{name}</span>
        </div>

        <div data-mock-piece class="mt-3.5 rounded-xl bg-brand p-3">
          <span class:list={[bar, 'h-1.5 w-10 bg-white/45']}></span>
          <span class:list={[bar, 'mt-2.5 h-2.5 w-[85%] bg-white/90']}></span>
          <span class:list={[bar, 'mt-1.5 h-2.5 w-[55%] bg-white/90']}></span>
          <span class="mt-3.5 inline-block h-5 w-14 rounded-full bg-marigold"></span>
        </div>

        {glyphTags.map((tag, i) => (
          <div data-mock-piece class:list={['mt-2.5 flex items-center gap-2.5 rounded-xl bg-mist-soft p-2', i > 1 && 'max-sm:hidden']}>
            <span class="grid size-8 shrink-0 place-items-center rounded-lg bg-surface ring-1 ring-line">
              <BrandGlyph name={tag} class="size-4 text-evergreen" />
            </span>
            <span class="flex-1">
              <span class:list={[bar, 'h-1.5 w-[75%] bg-line-strong/45']}></span>
              <span class:list={[bar, 'mt-1.5 h-1.5 w-[45%] bg-line']}></span>
            </span>
          </div>
        ))}

        <div data-mock-piece class="mt-auto flex justify-around border-t border-line pt-2.5">
          <span class="size-2 rounded-full bg-evergreen"></span>
          <span class="size-2 rounded-full bg-line-strong/40"></span>
          <span class="size-2 rounded-full bg-line-strong/40"></span>
          <span class="size-2 rounded-full bg-line-strong/40"></span>
        </div>
      </div>
    </div>
  </div>
) : (
  <div
    data-mock
    aria-hidden="true"
    class="w-full max-w-[24rem] rotate-[2deg] overflow-hidden rounded-xl bg-surface shadow-[0_40px_70px_-30px_rgb(18_36_28/0.6)] ring-1 ring-line"
  >
    <div class="flex items-center gap-3 border-b border-line bg-mist-soft px-3 py-2.5">
      <span class="flex gap-1.5">
        <span class="size-2.5 rounded-full bg-line-strong/45"></span>
        <span class="size-2.5 rounded-full bg-line-strong/45"></span>
        <span class="size-2.5 rounded-full bg-line-strong/45"></span>
      </span>
      <span class="flex min-w-0 flex-1 items-center gap-1.5 rounded-md bg-surface px-2.5 py-1 text-xs font-semibold text-quiet ring-1 ring-line">
        <svg class="size-3 shrink-0 fill-none stroke-current stroke-[2.5]" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
          <rect x="5" y="11" width="14" height="10" rx="2" />
          <path d="M8 11V8a4 4 0 0 1 8 0v3" />
        </svg>
        <span class="truncate">{host ?? 'localhost'}</span>
      </span>
    </div>

    <div class="p-4">
      <div data-mock-piece class="flex items-center justify-between">
        <span class="flex items-center gap-2 font-display text-sm font-bold">
          <span class="grid size-6 place-items-center rounded-md bg-evergreen text-xs text-on-evergreen">{initial}</span>
          {name}
        </span>
        <span class="flex gap-2">
          <span class:list={[bar, 'h-1.5 w-7 bg-line']}></span>
          <span class:list={[bar, 'h-1.5 w-7 bg-line']}></span>
          <span class:list={[bar, 'h-1.5 w-7 bg-line']}></span>
        </span>
      </div>

      <div data-mock-piece class="mt-4 rounded-lg bg-brand p-4">
        <span class:list={[bar, 'h-1.5 w-12 bg-white/45']}></span>
        <span class="mt-2.5 block font-display text-2xl leading-none font-bold text-white">{name}</span>
        <span class:list={[bar, 'mt-3 h-1.5 w-[70%] bg-white/55']}></span>
        <span class:list={[bar, 'mt-1.5 h-1.5 w-[45%] bg-white/55']}></span>
        <span class="mt-4 inline-block h-6 w-20 rounded-full bg-marigold"></span>
      </div>

      <div class="mt-3 grid grid-cols-3 gap-2">
        {glyphTags.map((tag) => (
          <div data-mock-piece class="rounded-lg bg-mist-soft p-2.5">
            <BrandGlyph name={tag} class="size-4 text-evergreen" />
            <span class:list={[bar, 'mt-2.5 h-1.5 w-[80%] bg-line-strong/40']}></span>
            <span class:list={[bar, 'mt-1.5 h-1.5 w-[50%] bg-line']}></span>
          </div>
        ))}
      </div>
    </div>
  </div>
)}
