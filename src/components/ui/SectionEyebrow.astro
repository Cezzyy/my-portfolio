---
/** Numbered section label: "01 ── About". Colour comes from the parent via `class`. */
interface Props {
  index?: string;
  class?: string;
}
const { index, class: className = 'text-evergreen' } = Astro.props;
---

<p data-reveal class:list={['flex items-center gap-3 font-semibold', className]}>
  {index && <span class="font-display text-sm font-bold tabular-nums">{index}</span>}
  <span data-rule class="h-px w-10 bg-current" aria-hidden="true"></span>
  <slot />
</p>
