---
/** "C" monogram on an evergreen tile, with a marigold dot. Same art as public/favicon.svg. */
interface Props {
  class?: string;
}
const { class: className = 'size-8' } = Astro.props;
---

<svg class={className} viewBox="0 0 32 32" aria-hidden="true">
  <rect width="32" height="32" rx="9" fill="#1e5b44" />
  <path d="M20.6 11.4A6.5 6.5 0 1 0 20.6 20.6" fill="none" stroke="#fff" stroke-width="3.6" stroke-linecap="round" />
  <circle cx="23.6" cy="16" r="2.3" fill="#f4a51c" />
</svg>
